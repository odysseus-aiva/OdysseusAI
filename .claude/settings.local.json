{
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.livekit.io)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(npx tsc *)",
      "WebFetch(domain:docs.bland.ai)",
      "WebFetch(domain:docs.vapi.ai)",
      "WebFetch(domain:docs.retellai.com)",
      "WebFetch(domain:elevenlabs.io)",
      "Bash(npm run *)",
      "Skill(deep-research)",
      "Bash(echo \"nest pid: $!\")",
      "Bash(echo \"next pid: $!\")",
      "Bash(curl -s http://localhost:3001/dashboard -o /dev/null -w \"%{http_code}\")",
      "Bash(curl -s http://localhost:3001/analytics -o /dev/null -w \"%{http_code}\")",
      "Bash(python3 *)",
      "Bash(pip3 install *)",
      "Bash(pkill -f \"nest start\")",
      "Bash(pkill -f \"next dev\")",
      "Bash(npx next *)",
      "Bash(curl -s http://localhost:3000/agents -w \"\\\\nbackend: %{http_code}\\\\n\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/)",
      "Bash(curl -s -o /dev/null -w \"landing: %{http_code}\\\\n\" http://localhost:3001/)",
      "Bash(curl -s -o /dev/null -w \"agent detail: %{http_code}\\\\n\" \"http://localhost:3001/agents/rohit-personal\")",
      "WebFetch(domain:docs.pyai.com)",
      "Bash(curl -s -X POST http://localhost:3000/agents -H \"Content-Type: application/json\" -d '{\"agentId\":\"engine-test-pipe\",\"name\":\"Pipe Test\"}')",
      "Bash(curl -s -X POST http://localhost:3000/agents -H \"Content-Type: application/json\" -d '{\"agentId\":\"engine-test-omni\",\"name\":\"Omni Test\",\"engine\":\"omni\"}')",
      "Bash(curl -s -X POST http://localhost:3000/agents -H \"Content-Type: application/json\" -d '{\"agentId\":\"engine-test-bad\",\"name\":\"Bad\",\"engine\":\"banana\"}')",
      "Bash(curl -s -X POST http://localhost:3000/session/start -H \"Content-Type: application/json\" -d '{\"agentConfig\":{\"agentId\":\"engine-test-omni\"}}' -o /dev/null -w \"%{http_code}\\\\n\")",
      "Bash(pkill -f \"nest\")",
      "Bash(pkill -f \"node.*main\")",
      "Bash(lsof -ti:3000)",
      "Bash(xargs kill -9)",
      "Bash(curl -s -X POST http://localhost:3000/session/start -H \"Content-Type: application/json\" -d '{\"agentConfig\":{\"agentId\":\"engine-test-omni\"}}' -o /dev/null -w \"http=%{http_code}\\\\n\")",
      "Bash(curl -s -X POST http://localhost:3000/session/start -H \"Content-Type: application/json\" -d '{\"agentConfig\":{\"agentId\":\"engine-test-pipe\"}}' -o /dev/null -w \"http=%{http_code}\\\\n\")",
      "Bash(curl -s -X DELETE http://localhost:3000/agents/engine-test-pipe -o /dev/null -w \"del pipe %{http_code}\\\\n\")",
      "Bash(curl -s -X DELETE http://localhost:3000/agents/engine-test-omni -o /dev/null -w \"del omni %{http_code}\\\\n\")",
      "Bash(curl -s -X POST http://localhost:3000/agents -H 'Content-Type: application/json' -d '{\"agentId\":\"pyai-test\",\"name\":\"PyAI Test\",\"defaultProviders\":{\"stt\":\"pyai\",\"tts\":\"pyai\"}}')",
      "Bash(curl -s -X POST http://localhost:3000/session/start -H 'Content-Type: application/json' -d '{\"agentConfig\":{\"agentId\":\"pyai-test\"}}' -o /dev/null -w 'http=%{http_code}\\\\n')",
      "Bash(curl -s -X DELETE http://localhost:3000/agents/pyai-test -o /dev/null -w \"del %{http_code}\\\\n\")",
      "Bash(curl -s http://localhost:3000/agents)",
      "Bash(curl -s http://localhost:3000/agents/assistant/tools)",
      "Bash(PERSISTENCE_PROVIDER=memory npm run start:dev)",
      "Bash(curl -s -X POST http://localhost:3000/agents -H \"Content-Type: application/json\" -d '{\"agentId\":\"omni-fb\",\"name\":\"Omni FB\",\"engine\":\"omni\"}' -o /dev/null -w \"create=%{http_code}\\\\n\")",
      "Bash(curl -s -X POST http://localhost:3000/session/start -H \"Content-Type: application/json\" -d '{\"agentConfig\":{\"agentId\":\"omni-fb\"}}' -o /dev/null -w \"http=%{http_code}\\\\n\")",
      "Bash(PYAI_API_KEY=pyai_fake_key_for_test npm run start:dev)",
      "Bash(PERSISTENCE_PROVIDER=mongodb npm run start:dev)",
      "Bash(curl -s -X DELETE http://localhost:3000/agents/omni-fb -o /dev/null -w \"del omni-fb=%{http_code}\\\\n\")",
      "Bash(node *)",
      "Bash(curl -s -X POST http://localhost:3000/agents -H \"Content-Type: application/json\" -d '{\"agentId\":\"omni-live\",\"name\":\"Omni Live\",\"engine\":\"omni\",\"greeting\":\"Hi, this is the Omni engine.\"}' -o /dev/null -w \"create=%{http_code}\\\\n\")",
      "Bash(curl -s -X POST http://localhost:3000/session/start -H \"Content-Type: application/json\" -d '{\"agentConfig\":{\"agentId\":\"omni-live\"}}' -o /dev/null -w \"http=%{http_code}\\\\n\")",
      "Bash(curl -s -X DELETE http://localhost:3000/agents/omni-live -o /dev/null -w \"del omni-live=%{http_code}\\\\n\")",
      "Bash(curl -s -X POST http://localhost:3000/agents -H \"Content-Type: application/json\" -d '{\"agentId\":\"omni-agent\",\"name\":\"Omni Agent\",\"engine\":\"omni\",\"greeting\":\"Hello! Welcome to the future of voice agents.\",\"systemPrompt\":\"You are a helpful assistant. Greet the caller.\"}' -o /dev/null -w \"create=%{http_code}\\\\n\")",
      "Bash(curl -s -X POST http://localhost:3000/session/start -H \"Content-Type: application/json\" -d '{\"agentConfig\":{\"agentId\":\"omni-agent\"}}' -o /dev/null -w \"http=%{http_code}\\\\n\")",
      "Bash(lsof -ti:3001)",
      "Bash(curl -s -X POST localhost:3000/session/start -H 'Content-Type: application/json' -d '{\"agentConfig\":{\"agentId\":\"abcde\"}}')",
      "Bash(curl -s localhost:3000/agents)",
      "Bash(curl -s -X PATCH localhost:3000/agents/rohit-personal -H 'Content-Type: application/json' -d '{\"voiceId\":\"stock_sarah_style2\"}')",
      "Bash(curl -s -X PUT localhost:3000/agents/rohit-personal -H 'Content-Type: application/json' -d '{\"voiceId\":\"stock_sarah_style2\",\"name\":\"Rohit Bot\",\"systemPrompt\":\"You are a helpful voice assistant. Keep answers short and natural for speech.\",\"greeting\":\"Hi there, how can I help today?\",\"engine\":\"omni\"}')"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true
  },
  "description": "Impeccable design detector: runs after Edit/Write/MultiEdit on UI files and surfaces findings as system reminders."
}
