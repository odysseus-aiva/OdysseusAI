# Server
PORT=3000

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_SECRET=

# LiveKit SIP / Telephony (inbound calls from Twilio numbers)
#
# Setup checklist:
#   1. Twilio Console → Elastic SIP Trunking → create trunk
#      Origination URI: sip:<your-project-subdomain>.sip.livekit.cloud;transport=tcp
#      Associate your Twilio phone number(s) with the trunk.
#
#   2. LiveKit Cloud → Telephony → SIP Trunks → create Inbound trunk
#      numbers: ["+1XXXXXXXXXX"]  (E.164, your Twilio DIDs)
#      → copy the returned trunk ID into LIVEKIT_SIP_TRUNK_ID
#
#   3. LiveKit Cloud → Telephony → Dispatch Rules → create rule
#      dispatchRuleIndividual roomPrefix: "call-"  (bind to trunk above)
#      → copy the returned rule ID into LIVEKIT_SIP_DISPATCH_RULE_ID
#
#   4. LiveKit Cloud → Project Settings → Webhooks
#      Point at: https://<your-host>/livekit/webhook
#
#   5. Set LIVEKIT_SIP_ENABLED=true and fill the IDs below.
#
LIVEKIT_SIP_ENABLED=false
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_DISPATCH_RULE_ID=
#
# Maps Twilio DIDs → agent IDs (JSON). The "default" key is used when no
# number matches. Omit to route all inbound calls to the "assistant" agent.
#
#   Example: LIVEKIT_SIP_PHONE_NUMBER_MAP={"default":"assistant","+15551234567":"sales-agent"}
#
LIVEKIT_SIP_PHONE_NUMBER_MAP=

# STT Providers  (deepgram | pyai)
DEEPGRAM_API_KEY=
DEFAULT_STT_PROVIDER=deepgram

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai

# TTS Providers  (openai | elevenlabs | cartesia | pyai)
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
DEFAULT_TTS_PROVIDER=openai

# PyAI — powers the "pyai" STT (Hear) and TTS (Speak) providers, and the Omni engine.
# Grab an instant sandbox key (no signup):
#   curl -X POST https://api.pyai.com/v1/sandbox/keys
PYAI_API_KEY=
PYAI_BASE_URL=

# Orchestration
ORCHESTRATION_MAX_TOOL_LOOPS=3
ORCHESTRATION_TOOL_TIMEOUT_MS=12000
ORCHESTRATION_FALLBACK_RESPONSE=I'm sorry, I had trouble with that. Could you try again?

# Built-in web search (provider: tavily | brave)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Persistence — mongodb by default, so call history, transcripts and analytics
# survive a restart and `npm run seed` has somewhere to load sample-data/ into.
#
# No MongoDB to hand, or the app can't reach it on startup? Switch to:
#   PERSISTENCE_PROVIDER=memory
# Everything still runs — live calls, tools, dashboard — but nothing is stored:
# history is wiped on every restart and `npm run seed` will refuse to run.
PERSISTENCE_PROVIDER=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=odysseus_ai

# Barge-in / interruption (listen while agent speaks; set ENABLED=false for half-duplex)
BARGE_IN_ENABLED=false
BARGE_IN_MIN_VOICE_MS=300
BARGE_IN_START_HOLDOFF_MS=400
BARGE_IN_BACKOFF_MS=700

# Twilio — required for buying phone numbers via the UI
# Get these from https://console.twilio.com
# TWILIO_ACCOUNT_SID  — Account SID (starts with AC)
# TWILIO_AUTH_TOKEN   — Auth token (keep secret)
# TWILIO_TRUNK_SID    — Elastic SIP Trunk SID (starts with TK)
#                       Purchased numbers are auto-attached to this trunk.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRUNK_SID=
